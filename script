            if h then
                local v = getNum("jumpVal", 120)
                h.UseJumpPower = true
                if h.JumpPower ~= v then h.JumpPower = v end
            end
        end)
    end, function()
        if jumpConn then jumpConn:Disconnect() jumpConn = nil end
        local hum = getHum()
        if hum then hum.JumpPower = origJump or 50 end
    end)
    makeSlider(pMove, "jumpVal", "Jump Power", nil, 50, 500, 120, "", function() end)

    local infJumpConn
    makeToggle(pMove, "infJump", "Infinite Jump", "Jump in air", false, function()
        infJumpConn = UserInputService.JumpRequest:Connect(function()
            local hrp, hum = getHRP(), getHum()
            if hrp and hum then
                local power = hum.JumpPower > 0 and hum.JumpPower or 50
                local v = hrp.AssemblyLinearVelocity
                hrp.AssemblyLinearVelocity = Vector3.new(v.X, power, v.Z)
            end
        end)
    end, function()
        if infJumpConn then infJumpConn:Disconnect() infJumpConn = nil end
    end)

    local noclipConn
    local noclipOriginal = setmetatable({}, { __mode = "k" })
    makeToggle(pUtil, "noclip", "Noclip", "Walk through walls", false, function()
        noclipConn = RunService.Stepped:Connect(function()
            local char = getChar()
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        if noclipOriginal[part] == nil then noclipOriginal[part] = part.CanCollide end
                        part.CanCollide = false
                    end
                end
            end
        end)
    end, function()
        if noclipConn then noclipConn:Disconnect() noclipConn = nil end
        for part, orig in pairs(noclipOriginal) do
            if part.Parent then part.CanCollide = orig end
            noclipOriginal[part] = nil
        end
