        Mobile  = ui:TabCreate({ Name = "Mobile",  Icon = "M", Description = "On-screen toggle" }),
        Misc    = ui:TabCreate({ Name = "Misc",    Icon = "S", Description = "Connection & config" }),
    }

    -- PLAYER TAB
    local pMove = tabs.Player:SectionCreate({ Name = "Movement", Side = "Left" })
    local pUtil = tabs.Player:SectionCreate({ Name = "Utility", Side = "Right" })

    local flyVert, flyControls, flyConn = 0, nil, nil
    local FlyGui = Instance.new("ScreenGui")
    FlyGui.Name = "OnrushaFly"
    FlyGui.ResetOnSpawn = false
    FlyGui.Enabled = false
    FlyGui.Parent = (gethui and gethui()) or CoreGui

    local function getFlyControls()
        if flyControls then return flyControls end
        pcall(function()
            local ps = LocalPlayer:FindFirstChild("PlayerScripts")
            local pm = ps and ps:FindFirstChild("PlayerModule")
            if pm then flyControls = require(pm):GetControls() end
        end)
        return flyControls
    end

    local function getFlyMove()
        local c = getFlyControls()
        if c then
            local ok, v = pcall(function() return c:GetMoveVector() end)
            if ok and typeof(v) == "Vector3" then return v end
        end
        local x = (UserInputService:IsKeyDown(Enum.KeyCode.D) and 1 or 0) - (UserInputService:IsKeyDown(Enum.KeyCode.A) and 1 or 0)
        local z = (UserInputService:IsKeyDown(Enum.KeyCode.S) and 1 or 0) - (UserInputService:IsKeyDown(Enum.KeyCode.W) and 1 or 0)
        return Vector3.new(x, 0, z)
    end

    local function removeFlyObjects()
        local hrp = getHRP()
        if hrp then
            local g = hrp:FindFirstChild("OnrushaFlyGyro")
            local v = hrp:FindFirstChild("OnrushaFlyVelocity")
            if g then g:Destroy() end
            if v then v:Destroy() end
        end
        local hum = getHum()
        if hum then hum.PlatformStand = false end
    end

    makeToggle(pMove, "fly", "Fly", "WASD + E/Q", false, function()
        FlyGui.Enabled = IS_TOUCH
        flyVert = 0
        flyConn = RunService.RenderStepped:Connect(function()
            local hrp, hum = getHRP(), getHum()
            if not hrp or not hum then return end
            local bg = hrp:FindFirstChild("OnrushaFlyGyro")
            if not bg then
                bg = Instance.new("BodyGyro")
                bg.Name = "OnrushaFlyGyro"
                bg.MaxTorque = Vector3.new(90000, 90000, 90000)
                bg.P = 20000
                bg.Parent = hrp
            end
            local bv = hrp:FindFirstChild("OnrushaFlyVelocity")
            if not bv then
                bv = Instance.new("BodyVelocity")
                bv.Name = "OnrushaFlyVelocity"
                bv.MaxForce = Vector3.new(90000, 90000, 90000)
                bv.Velocity = Vector3.zero
                bv.Parent = hrp
            end
            hum.PlatformStand = true
            local cam = workspace.CurrentCamera
            bg.CFrame = cam.CFrame
            local mv = getFlyMove()
            local vel = cam.CFrame.LookVector * (-mv.Z) + cam.CFrame.RightVector * mv.X
            local vert = flyVert
            if UserInputService:IsKeyDown(Enum.KeyCode.E) then vert += 1 end
            if UserInputService:IsKeyDown(Enum.KeyCode.Q) then vert -= 1 end
            vel += Vector3.new(0, math.clamp(vert, -1, 1), 0)
            if vel.Magnitude > 1 then vel = vel.Unit end
            bv.Velocity = vel * getNum("flySpeedVal", 50)
        end)
    end, function()
        if flyConn then flyConn:Disconnect() flyConn = nil end
        FlyGui.Enabled = false
        flyVert = 0
        removeFlyObjects()
    end)
    makeSlider(pMove, "flySpeedVal", "Fly Speed", nil, 10, 300, 50, "", function() end)

    local speedConn, origWalk
    makeToggle(pMove, "speed", "Speed", "WalkSpeed", false, function()
