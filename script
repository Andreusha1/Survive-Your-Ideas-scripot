    local function buildNameToId(lib)
        local map = {}
        if not lib or not lib.Items then return map end
        for _, item in ipairs(lib.Items) do
            if item.name and item.id then map[item.name] = item.id end
        end
        return map
    end

    local function isOwnedColor(bg)
        local r = math.floor(bg.R * 255 + 0.5)
        local g = math.floor(bg.G * 255 + 0.5)
        local b = math.floor(bg.B * 255 + 0.5)
        return (math.abs(r - 255) < 8 and math.abs(g - 246) < 8 and math.abs(b - 229) < 8)
            or (math.abs(r - 255) < 8 and math.abs(g - 201) < 8 and math.abs(b - 60) < 8)
    end

    local function getOwnedSlots()
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        local roll = pg and pg:FindFirstChild("SYI_ItemRoll")
        local root = roll and roll:FindFirstChild("Root")
        local canvas = root and root:FindFirstChild("Canvas")
        local window = canvas and canvas:FindFirstChild("Window")
        local collection = window and window:FindFirstChild("Collection")
        if not collection then return {} end
        local slots = {}
        for _, slot in ipairs(collection:GetChildren()) do
            local face = slot:FindFirstChild("Face", true)
            if face and face:IsA("Frame") then
                table.insert(slots, {
                    name = slot.Name,
                    owned = isOwnedColor(face.BackgroundColor3),
                })
            end
        end
        return slots
    end

    local function buildBestIds(slots, lib, nameToId)
        local list = {}
        for _, s in ipairs(slots) do
            if s.owned then
                local id = nameToId[s.name] or nameToId[s.name:lower()] or s.name:lower():gsub("%s+", "_")
                local item = lib.get and lib.get(id) or nil
                if item then
                    local tier = lib.tierIndex and lib.tierIndex(item.tier) or 0
                    table.insert(list, { id = id, tier = tier })
                end
            end
        end
        table.sort(list, function(a, b) return a.tier > b.tier end)
        local out = {}
        local size = lib.LOADOUT_SIZE or 5
        for i = 1, math.min(size, #list) do table.insert(out, list[i].id) end
        return out
    end

    local function arrayEquals(a, b)
        if not a or not b or #a ~= #b then return false end
        for i = 1, #a do
            if a[i] ~= b[i] then return false end
        end
        return true
    end

    local function sendLoadout(ids)
        local ev = ReplicatedStorage:FindFirstChild("Items")
        ev = ev and ev:FindFirstChild("Remotes")
        ev = ev and ev:FindFirstChild("Request")
        if not ev then return nil end
        local ok, res = pcall(function() return ev:InvokeServer("loadout", ids) end)
        if ok and type(res) == "table" and res.state then return res.state end
        return nil
    end

