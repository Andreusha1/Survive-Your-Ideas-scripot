    local function makeToggle(section, id, name, desc, default, onEnable, onDisable)
        local t = section:ToggleCreate({ Id = id, Name = name, Description = desc, Default = default or false })
        local feature = { active = false, widget = t }
        function feature.set(on)
            if feature.active == on then return end
            feature.active = on
            if on then pcall(onEnable) else pcall(onDisable) end
            settings.toggles[id] = on
            saveSettings()
        end
        t:OnChanged(function(v) feature.set(v) end)
        features[id] = feature
        return feature
    end

    local function makeSlider(section, id, name, desc, min, max, default, suffix, onChange)
        local s = section:SliderCreate({
            Id = id, Name = name, Description = desc,
            Min = min, Max = max, Default = default, Step = 1, Suffix = suffix or "",
        })
        settings.values[id] = default
        s:OnChanged(function(v)
            settings.values[id] = v
            saveSettings()
            if onChange then pcall(onChange, v) end
        end)
        return s
    end

