    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude

    local function isVisible(cam, part, char)
        local filter = { char }
        if LocalPlayer.Character then table.insert(filter, LocalPlayer.Character) end
        rayParams.FilterDescendantsInstances = filter
        local origin = cam.CFrame.Position
        return workspace:Raycast(origin, part.Position - origin, rayParams) == nil
    end

    local function evaluate(player, cam, center, useFov)
        if player == LocalPlayer then return end
        local char = player.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return end
        local part = getAimPart(char)
        if not part then return end
        local sp, onScreen = cam:WorldToViewportPoint(part.Position)
        if not onScreen then return end
        local sd = (Vector2.new(sp.X, sp.Y) - center).Magnitude
        if useFov and sd > getNum("aimFov", 200) then return end
        if aimOpt.wall and not isVisible(cam, part, char) then return end
        return part, sd
    end

    local function findTarget(cam, center)
        local best, bestScore
        for _, p in ipairs(Players:GetPlayers()) do
            local part, sd = evaluate(p, cam, center, true)
            if part and (not bestScore or sd < bestScore) then
                best, bestScore = p, sd
            end
        end
        return best
    end

    local function aimStep(dt)
        local cam = workspace.CurrentCamera
        if not cam then return end
        local center = cam.ViewportSize / 2
        local fov = getNum("aimFov", 200)
        fovCircle.Position = UDim2.fromOffset(center.X, center.Y)
        fovCircle.Size = UDim2.fromOffset(fov * 2, fov * 2)
        fovCircle.Visible = aimOpt.fovCircle == true and (features.aimbot and features.aimbot.active or false)
        if not isAiming() then lockedTarget = nil lastLockName = nil return end
        local part
        if lockedTarget then
            part = evaluate(lockedTarget, cam, center, false)
            if not part then lockedTarget = nil end
        end
        if not lockedTarget then
            lockedTarget = findTarget(cam, center)
            if lockedTarget then part = evaluate(lockedTarget, cam, center, false) end
        end
        if not lockedTarget or not part then lastLockName = nil return end
        if lastLockName ~= lockedTarget.Name then
            lastLockName = lockedTarget.Name
            notify("Aimbot -> " .. lockedTarget.Name)
        end
        local s = math.max(getNum("aimSmooth", 2), 1)
        local alpha = (s <= 1) and 1 or (1 - (1 - 1 / s) ^ (dt * 60))
        local camPos = cam.CFrame.Position
        cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(camPos, part.Position), alpha)
    end

