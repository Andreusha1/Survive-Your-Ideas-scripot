local function createLobbyUI()
    local ui = Onrusha.Create({
        Name = HUB_NAME .. " — Lobby",
        Subtitle = "Survive Your Ideas",
        Open = true,
        ToggleKey = Enum.KeyCode.H,
        Theme = "Black & White",
        Scale = 0.96,
        Draggable = true,
        MobileSupport = true,
        Blur = true,
        BackgroundEffect = "Starfall",
        BackgroundTransparency = 0.05,
        WindowParticles = true,
        WindowParticleStyle = "Orbs",
        DragEffectStyle = "Soft Glow",
    })

    local function notify(text, kind)
        ui:Notify({ Title = HUB_NAME, Description = tostring(text), Type = kind or "Info", Duration = 2 })
    end

    local lobbyTab = ui:TabCreate({ Name = "Lobby", Icon = "L", Description = "Lobby tools" })
    local mainSec  = lobbyTab:SectionCreate({ Name = "Play", Side = "Left" })
    local spinSec  = lobbyTab:SectionCreate({ Name = "Spins", Side = "Right" })
    local itemsSec = lobbyTab:SectionCreate({ Name = "Auto Items", Side = "Left" })
    local codeSec  = lobbyTab:SectionCreate({ Name = "Codes", Side = "Right" })

    -- START GAME
    mainSec:ButtonCreate({
        Id = "lobby_start", Name = "Start Game",
        Description = "QueueRemotes.PlayJump:FireServer()", ButtonText = "Start",
    }):OnClick(function()
        local ev = ReplicatedStorage:FindFirstChild("QueueRemotes")
        ev = ev and ev:FindFirstChild("PlayJump")
        if ev then ev:FireServer() notify("Game started!", "Success")
        else notify("PlayJump remote not found", "Error") end
    end)

    -- AUTO BUY SPIN
    local spinDelay = spinSec:SliderCreate({
        Id = "spin_delay", Name = "Spin delay (s)", Min = 1, Max = 50, Default = 1, Step = 1,
    })
    local spinEnabled, spinThread = false, nil

    local function pressItemsButton()
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        local lobby = pg and pg:FindFirstChild("SYI_LobbyMenu")
        local column = lobby and lobby:FindFirstChild("Column")
        local itemsBtn = column and column:FindFirstChild("ItemsButton")
        local key = itemsBtn and itemsBtn:FindFirstChild("Key")
        if key then safeClick(key) return true end
        return false
    end

    local function doSpin()
        local ev = ReplicatedStorage:FindFirstChild("Items")
        ev = ev and ev:FindFirstChild("Remotes")
        ev = ev and ev:FindFirstChild("Request")
        if ev then pcall(function() ev:InvokeServer("spin", nil) end) return true end
        return false
    end

    spinSec:ToggleCreate({
        Id = "auto_spin", Name = "Auto Buy Spin",
        Description = "Press Items button and spin automatically", Default = false,
    }):OnChanged(function(v)
        spinEnabled = v
        if v then
            spinThread = task.spawn(function()
                while spinEnabled do
                    pressItemsButton()
                    task.wait(0.1)
                    doSpin()
                    task.wait(math.max(0.1, spinDelay:Get() / 10))
                end
            end)
        else
            if spinThread then task.cancel(spinThread) spinThread = nil end
        end
    end)

    -- AUTO BEST ITEMS
    local function getItemLibrary()
        local itemsFolder = ReplicatedStorage:FindFirstChild("Items")
        local lib = itemsFolder and itemsFolder:FindFirstChild("ItemLibrary")
        if not lib then return nil end
        local ok, mod = pcall(require, lib)
        if ok then return mod end
        return nil
    end

    local function buildNameToId(lib)
        local map = {}
        if not lib or not lib.Items then return map end
        for _, item in ipairs(lib.Items) do
            if item.name and item.id then map[item.name] = item.id end
        end
        return map
    end

    local function isOwnedColor(bg)
        local r = math.floor(bg.R * 255 + 0.5)
        local g = math.floor(bg.G * 255 + 0.5)
        local b = math.floor(bg.B * 255 + 0.5)
        return (math.abs(r - 255) < 8 and math.abs(g - 246) < 8 and math.abs(b - 229) < 8)
            or (math.abs(r - 255) < 8 and math.abs(g - 201) < 8 and math.abs(b - 60) < 8)
    end

    local function getOwnedSlots()
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        local roll = pg and pg:FindFirstChild("SYI_ItemRoll")
        local root = roll and roll:FindFirstChild("Root")
        local canvas = root and root:FindFirstChild("Canvas")
        local window = canvas and canvas:FindFirstChild("Window")
        local collection = window and window:FindFirstChild("Collection")
        if not collection then return {} end
        local slots = {}
        for _, slot in ipairs(collection:GetChildren()) do
            local face = slot:FindFirstChild("Face", true)
            if face and face:IsA("Frame") then
                table.insert(slots, { name = slot.Name, owned = isOwnedColor(face.BackgroundColor3) })
            end
        end
        return slots
    end

    local function buildBestIds(slots, lib, nameToId)
        local list = {}
        for _, s in ipairs(slots) do
            if s.owned then
                local id = nameToId[s.name] or nameToId[s.name:lower()] or s.name:lower():gsub("%s+", "_")
                local item = lib.get and lib.get(id) or nil
                if item then
                    local tier = lib.tierIndex and lib.tierIndex(item.tier) or 0
                    table.insert(list, { id = id, tier = tier })
                end
            end
        end
        table.sort(list, function(a, b) return a.tier > b.tier end)
        local out = {}
        local size = lib.LOADOUT_SIZE or 5
        for i = 1, math.min(size, #list) do table.insert(out, list[i].id) end
        return out
    end

    local function arrayEquals(a, b)
        if not a or not b or #a ~= #b then return false end
        for i = 1, #a do if a[i] ~= b[i] then return false end end
        return true
    end

    local function sendLoadout(ids)
        local ev = ReplicatedStorage:FindFirstChild("Items")
        ev = ev and ev:FindFirstChild("Remotes")
        ev = ev and ev:FindFirstChild("Request")
        if not ev then return nil end
        local ok, res = pcall(function() return ev:InvokeServer("loadout", ids) end)
        if ok and type(res) == "table" and res.state then return res.state end
        return nil
    end

    local function refreshInventoryUI()
        pcall(function()
            local pg = LocalPlayer:FindFirstChild("PlayerGui")
            local lobby = pg and pg:FindFirstChild("SYI_LobbyMenu")
            local column = lobby and lobby:FindFirstChild("Column")
            local itemsBtn = column and column:FindFirstChild("ItemsButton")
            local key = itemsBtn and itemsBtn:FindFirstChild("Key")
            if key then
                safeClick(key)
                task.wait(0.15)
                safeClick(key)
            end
        end)
    end

    local autoBest = itemsSec:ToggleCreate({
        Id = "auto_best", Name = "Auto Best Items",
        Description = "Equip highest-tier owned items automatically via loadout", Default = false,
    })
    local bestThread = nil

    autoBest:OnChanged(function(v)
        if v then
            bestThread = task.spawn(function()
                local ok, err = pcall(function()
                    local lib = getItemLibrary()
                    if not lib then notify("ItemLibrary not found", "Error") autoBest:Set(false) return end
                    local nameToId = buildNameToId(lib)
                    while autoBest:Get() do
                        local slots = getOwnedSlots()
                        local bestIds = buildBestIds(slots, lib, nameToId)
                        if #bestIds > 0 then
                            local state = sendLoadout(bestIds)
                            if state and state.loadout and arrayEquals(state.loadout, bestIds) then
                                refreshInventoryUI()
                            end
                        else
                            notify("No owned items found", "Warning")
                        end
                        task.wait(3)
                    end
                end)
                if not ok then notify("Auto Best error: " .. tostring(err), "Error") end
            end)
        else
            if bestThread then pcall(task.cancel, bestThread) bestThread = nil end
        end
    end)

    -- AUTO REDEEM CODES
    local CODES = { "BIG5", "NEWMAPSCOMING", "FIRSTUPDATE", "THANKYOU" }
    local codeDropdown = codeSec:DropdownCreate({
        Id = "codes_select", Name = "Select Code", Options = CODES, Default = CODES[1],
    })

    codeSec:ButtonCreate({
        Id = "redeem_one", Name = "Redeem Selected",
        Description = "Runs Codes.Redeem for the chosen code", ButtonText = "Redeem",
    }):OnClick(function()
        local ev = ReplicatedStorage:FindFirstChild("Codes")
        ev = ev and ev:FindFirstChild("Redeem")
        if not ev then notify("Codes.Redeem not found", "Error") return end
        local code = codeDropdown:Get()
        if not code or code == "" then notify("No code selected", "Warning") return end
        pcall(function() ev:InvokeServer(code) end)
        notify("Redeemed: " .. code, "Success")
    end)

    codeSec:ButtonCreate({
        Id = "redeem_all", Name = "Redeem All",
        Description = "Runs Codes.Redeem for every code", ButtonText = "Redeem All",
    }):OnClick(function()
        local ev = ReplicatedStorage:FindFirstChild("Codes")
        ev = ev and ev:FindFirstChild("Redeem")
        if not ev then notify("Codes.Redeem not found", "Error") return end
        for _, code in ipairs(CODES) do
            pcall(function() ev:InvokeServer(code) end)
            task.wait(0.5)
        end
        notify("All codes redeemed", "Success")
    end)

    -- RELEASE MOUSE + MARK CLOSED
    do
        local origHide, origToggle = ui.Hide, ui.Toggle
        if type(origHide) == "function" then
            ui.Hide = function(self)
                local ok, err = pcall(origHide, self)
                releaseMouse()
                _G[STATE_KEY].closed = true
                return ok, err
            end
        end
        if type(origToggle) == "function" then
            ui.Toggle = function(self)
                local ok, err = pcall(origToggle, self)
                releaseMouse()
                return ok, err
            end
        end
        track(UserInputService.InputBegan:Connect(function(input, gpe)
            if not gpe and input.KeyCode == Enum.KeyCode.H then
                task.delay(0.05, releaseMouse)
            end
        end))
    end

    track(LocalPlayer.CharacterAdded:Connect(function()
        task.wait(2)
        if isInMatch() and not _G[STATE_KEY].closed then
            pcall(function() ui:Hide() end)
            releaseMouse()
            createFullUI()
        end
    end))

    return ui
end
