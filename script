    -- CUSTOM CURSOR
    do
        local DEFAULT_CURSOR = "Crosshair"
        local CURSOR_SHAPES = {
            { "Dot", "Dot" }, { "Ring", "Ring" }, { "Crosshair", "Cross" },
            { "Gap", "Gap Cross" }, { "GapDot", "Gap Dot" }, { "RingDot", "Ring Dot" },
            { "Diag", "Diagonal" }, { "Brackets", "Brackets" }, { "Tri", "Tri" },
            { "Diamond", "Diamond" }, { "Square", "Square" }, { "Heart", "Heart" },
        }
        local cursorState = {
            gui = nil, frame = nil, scale = nil, parts = {},
            rotation = 0, clickAt = -9, hidden = false,
            settings = {
                cursor = DEFAULT_CURSOR, cursorSize = 100, cursorFade = 0,
                cursorOutline = true, cursorRainbow = false, cursorRainbowSpd = 3,
                cursorPulse = false, cursorPulseSpd = 3, cursorPulseAmt = 20,
                cursorSpin = false, cursorSpinSpd = 180, cursorSpinRev = false,
                cursorClick = false, cursorClickAmt = 30,
                cursorR = 255, cursorG = 255, cursorB = 255,
            },
        }

        local function element(parent, x, y, w, h, rotation, rounded, zIndex)
            local frame = Instance.new("Frame")
            frame.BorderSizePixel = 0
            frame.AnchorPoint = Vector2.new(0.5, 0.5)
            frame.Position = UDim2.new(0.5, x, 0.5, y)
            frame.Size = UDim2.fromOffset(w, h)
            frame.Rotation = rotation or 0
            frame.ZIndex = zIndex or 3
            frame.BackgroundColor3 = Color3.new(1, 1, 1)
            if rounded then
                local c = Instance.new("UICorner")
                c.CornerRadius = UDim.new(rounded, 0)
                c.Parent = frame
            end
            frame.Parent = parent
            return frame
        end

        local function drawShape(parent, shape)
            for _, child in ipairs(parent:GetChildren()) do
                if not child:IsA("UIScale") then child:Destroy() end
            end
            local parts = {}
            local function fill(x, y, w, h, rotation, rounded, noOutline)
                local outline
                if not noOutline then
                    outline = element(parent, x, y, w + 2, h + 2, rotation, rounded, 2)
                    outline.BackgroundColor3 = Color3.new(0, 0, 0)
                end
                local frame = element(parent, x, y, w, h, rotation, rounded, 3)
                table.insert(parts, { kind = "fill", frame = frame, outline = outline })
            end
            local function ring(x, y, size, thickness, rotation, square)
                local rounded = not square and 0.5 or nil
                local outline = element(parent, x, y, size - 2, size - 2, rotation, rounded, 2)
                outline.BackgroundTransparency = 1
                local outerStroke = Instance.new("UIStroke")
                outerStroke.Color = Color3.new(0, 0, 0)
                outerStroke.Thickness = thickness + 2
                outerStroke.Parent = outline
                local frame = element(parent, x, y, size, size, rotation, rounded, 3)
                frame.BackgroundTransparency = 1
                local stroke = Instance.new("UIStroke")
                stroke.Thickness = thickness
                stroke.Parent = frame
                table.insert(parts, { kind = "ring", frame = frame, stroke = stroke, outline = outline, outerStroke = outerStroke })
            end
            if shape == "Dot" then fill(0, 0, 6, 6, 0, 0.5) end
            if shape == "Ring" then ring(0, 0, 14, 2) end
            if shape == "Crosshair" then fill(0, 0, 18, 2) fill(0, 0, 2, 18) end
            if shape == "Gap" or shape == "GapDot" then
                fill(7, 0, 8, 2) fill(-7, 0, 8, 2) fill(0, 7, 2, 8) fill(0, -7, 2, 8)
                if shape == "GapDot" then fill(0, 0, 2, 2) end
            end
            if shape == "RingDot" then ring(0, 0, 16, 2) fill(0, 0, 4, 4, 0, 0.5) end
            if shape == "Diag" then
                fill(5, 5, 8, 2, 45) fill(-5, -5, 8, 2, 45) fill(5, -5, 8, 2, -45) fill(-5, 5, 8, 2, -45)
            end
            if shape == "Brackets" then
                for _, x in ipairs({ -1, 1 }) do
                    for _, y in ipairs({ -1, 1 }) do
                        fill(x * 7, y * 9, 6, 2) fill(x * 9, y * 7, 2, 6)
                    end
                end
                fill(0, 0, 2, 2)
            end
            if shape == "Tri" then fill(0, -8, 8, 2, 90) fill(7, 4, 8, 2, 30) fill(-7, 4, 8, 2, 150) end
            if shape == "Diamond" then ring(0, 0, 12, 2, 45, true) end
            if shape == "Square" then ring(0, 0, 14, 2, 0, true) fill(0, 0, 2, 2) end
            if shape == "Heart" then
                fill(-4, -3, 10, 10, 0, 0.5, true) fill(4, -3, 10, 10, 0, 0.5, true) fill(0, 2, 12, 12, 45, nil, true)
            end
            return parts
        end

        local function paintParts(parts, color, fade, showOutline)
            for _, part in ipairs(parts or {}) do
                if part.kind == "fill" then
                    part.frame.BackgroundColor3 = color
                    part.frame.BackgroundTransparency = fade
                    if part.outline then
                        part.outline.Visible = showOutline
                        part.outline.BackgroundTransparency = 1 - (1 - fade) * 0.4
                    end
                elseif part.kind == "ring" then
                    part.stroke.Color = color
                    part.stroke.Transparency = fade
                    part.outline.Visible = showOutline
                    part.outerStroke.Transparency = 1 - (1 - fade) * 0.4
                end
            end
        end

        local function color(now)
            local s = cursorState.settings
            if s.cursorRainbow then return Color3.fromHSV(now * (tonumber(s.cursorRainbowSpd) or 3) * 0.06 % 1, 0.8, 1) end
            return Color3.fromRGB(tonumber(s.cursorR) or 255, tonumber(s.cursorG) or 255, tonumber(s.cursorB) or 255)
        end

        local function scaleValue(now, clicked, base)
            local s, value = cursorState.settings, base
            if s.cursorPulse then
                local speed = (tonumber(s.cursorPulseSpd) or 3) * 0.35
                value = value * (1 + math.clamp((tonumber(s.cursorPulseAmt) or 20) / 100, 0, 1) * math.sin(now * speed * math.pi * 2))
            end
            local elapsed = now - clicked
            if s.cursorClick and elapsed >= 0 and elapsed < 0.24 then
                value = value * (1 - math.clamp((tonumber(s.cursorClickAmt) or 30) / 100, 0, 0.9) * math.sin(elapsed / 0.24 * math.pi))
            end
            return math.max(value, 0.05)
        end

        local function ensureGui()
            if cursorState.gui and cursorState.gui.Parent then return end
            local gui = Instance.new("ScreenGui")
            gui.Name = "OnrushaCursor"
            gui.ResetOnSpawn = false
            gui.DisplayOrder = 2147483000
            gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
            gui.IgnoreGuiInset = true
            pcall(function() gui.Parent = CoreGui end)
            if not gui.Parent then
                pcall(function() gui.Parent = PlayerGui end)
                gui.DisplayOrder = 999999
            end
            local frame = Instance.new("Frame")
            frame.Name = "K"
            frame.BackgroundTransparency = 1
            frame.AnchorPoint = Vector2.new(0.5, 0.5)
            frame.Size = UDim2.fromOffset(64, 64)
            frame.Visible = false
            frame.Parent = gui
            local scale = Instance.new("UIScale")
            scale.Parent = frame
            cursorState.gui, cursorState.frame, cursorState.scale = gui, frame, scale
        end

        local function build()
            ensureGui()
            cursorState.parts = drawShape(cursorState.frame, cursorState.settings.cursor)
            paintParts(cursorState.parts, color(os.clock()), cursorState.settings.cursorFade / 100, cursorState.settings.cursorOutline ~= false)
        end

        local function hideNative(hidden)
            if hidden then
                cursorState.hidden = true
                pcall(function() UserInputService.MouseIconEnabled = false end)
            else
                if cursorState.hidden then
                    cursorState.hidden = false
                    pcall(function() UserInputService.MouseIconEnabled = true end)
                end
            end
        end

        local function applyState()
            local s = cursorState.settings
            if not wig.CustomCursor:Get() then
                if cursorState.gui then cursorState.gui:Destroy() cursorState.gui = nil cursorState.frame = nil cursorState.scale = nil end
                cursorState.parts = {}
                hideNative(false)
                return
            end
            if s.cursor == "Off" then
                if cursorState.gui then cursorState.gui.Enabled = false end
                cursorState.parts = {}
                hideNative(false)
                return
            end
            ensureGui()
            if cursorState.gui then cursorState.gui.Enabled = true end
            build()
            hideNative(true)
        end

        local styleOptions = { "Off" }
        for _, item in ipairs(CURSOR_SHAPES) do table.insert(styleOptions, item[1] .. " - " .. item[2]) end

        local function parseOption(raw)
            if type(raw) ~= "string" then return "Off" end
            if raw == "Off" then return "Off" end
            local short = raw:match("^(%S+)%s%-%s")
            return short or raw
        end

        wig.CustomCursor = vCursor:ToggleCreate({
            Id = "CustomCursor.Enabled", Name = "Custom Cursor",
            Description = "Replace the default cursor", Default = false,
        })
        local cursorSettings = wig.CustomCursor:CreateSettings({ Name = "Cursor Settings" })
        wig.CursorStyle = cursorSettings:DropdownCreate({
            Id = "CustomCursor.Style", Name = "Cursor", Options = styleOptions,
            Default = DEFAULT_CURSOR .. " - Cross",
        })
        wig.CursorSize = cursorSettings:SliderCreate({
            Id = "CustomCursor.Size", Name = "Size", Min = 40, Max = 300, Default = 100,
        })
        wig.CursorFade = cursorSettings:SliderCreate({
            Id = "CustomCursor.Fade", Name = "Transparency", Min = 0, Max = 90, Default = 0,
        })
        wig.CursorColor = cursorSettings:ColorPickerCreate({
            Id = "CustomCursor.Color", Name = "Color", Default = Color3.fromRGB(255, 255, 255),
        })
        wig.CursorOutline = cursorSettings:ToggleCreate({
            Id = "CustomCursor.Outline", Name = "Outline", Default = true,
        })
        wig.CursorRainbow = cursorSettings:ToggleCreate({
            Id = "CustomCursor.Rainbow", Name = "Rainbow", Default = false,
        })

        wig.CursorStyle:OnChanged(function(value) cursorState.settings.cursor = parseOption(value) applyState() end)
        wig.CursorSize:OnChanged(function(value) cursorState.settings.cursorSize = value if cursorState.frame then cursorState.scale.Scale = value / 100 end end)
        wig.CursorFade:OnChanged(function(value) cursorState.settings.cursorFade = value if wig.CustomCursor:Get() and cursorState.frame then build() end end)
        wig.CursorColor:OnChanged(function(value)
            cursorState.settings.cursorR = math.floor(value.R * 255 + 0.5)
            cursorState.settings.cursorG = math.floor(value.G * 255 + 0.5)
            cursorState.settings.cursorB = math.floor(value.B * 255 + 0.5)
            if wig.CustomCursor:Get() and cursorState.frame then build() end
        end)
        wig.CursorOutline:OnChanged(function(value) cursorState.settings.cursorOutline = value if wig.CustomCursor:Get() and cursorState.frame then build() end end)
        wig.CursorRainbow:OnChanged(function(value) cursorState.settings.cursorRainbow = value end)
        wig.CustomCursor:OnChanged(function() applyState() end)

        track(UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then cursorState.clickAt = os.clock() end
        end))

        track(RunService.RenderStepped:Connect(function()
            if not wig.CustomCursor:Get() or cursorState.settings.cursor == "Off" then return end
            if not cursorState.frame then return end
            local s = cursorState.settings
            local now = os.clock()
            pcall(function() UserInputService.MouseIconEnabled = false end)
            if s.cursorSpin then
                cursorState.rotation = (cursorState.rotation + (1 / 60) * (tonumber(s.cursorSpinSpd) or 180) * (s.cursorSpinRev and -1 or 1)) % 360
            else
                cursorState.rotation = 0
            end
            local mouseEnabled = UserInputService.MouseEnabled
            cursorState.frame.Visible = mouseEnabled
            if not mouseEnabled then return end
            local location = UserInputService:GetMouseLocation()
            cursorState.frame.Position = UDim2.fromOffset(location.X, location.Y)
            cursorState.frame.Rotation = cursorState.rotation
            cursorState.scale.Scale = scaleValue(now, cursorState.clickAt, math.clamp((tonumber(s.cursorSize) or 100) / 100, 0.2, 4))
            if s.cursorRainbow then
                paintParts(cursorState.parts, color(now), s.cursorFade / 100, s.cursorOutline ~= false)
            end
        end))

        applyState()
    end

