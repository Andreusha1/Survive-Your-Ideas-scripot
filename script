    local function muteRagdollListeners()
        local ev = getRagdollEvent()
        if not (ev and getconnections) then return end
        pcall(function()
            for _, con in ipairs(getconnections(ev.OnClientEvent)) do
                if not arSeen[con] and con.Enabled ~= false and con.Disable then
                    arSeen[con] = true
                    con:Disable()
                    table.insert(arDisabled, con)
                end
            end
        end)
    end

    local function applyAntiRagdoll(char)
        if not char then return end
        if char:GetAttribute("Ragdolled") then char:SetAttribute("Ragdolled", nil) end
        if arAttrConn then arAttrConn:Disconnect() end
        arAttrConn = char:GetAttributeChangedSignal("Ragdolled"):Connect(function()
            if char:GetAttribute("Ragdolled") then
                char:SetAttribute("Ragdolled", nil)
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum.PlatformStand = false
                    hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                end
            end
        end)
        local hum = char:WaitForChild("Humanoid", 5)
        if hum then
            pcall(function()
                hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            end)
            if arPSConn then arPSConn:Disconnect() end
            arPSConn = hum:GetPropertyChangedSignal("PlatformStand"):Connect(function()
                if hum.PlatformStand and not (features.fly and features.fly.active) then
                    task.defer(function()
                        hum.PlatformStand = false
                        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                    end)
                end
            end)
        end
    end

