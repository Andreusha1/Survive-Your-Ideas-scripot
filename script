    local function updateESP()
        local cam = workspace.CurrentCamera
        if not cam then return end
        local vp = cam.ViewportSize
        local myHRP = getHRP()
        local maxDist = getNum("espMaxDist", 1000)
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local char = player.Character
                local d = espObjects[player]
                if not char then
                    if d then removeESP(player) end
                else
                    if not d or d.char ~= char then createESP(player) d = espObjects[player] end
                    if d then
                        local hum = char:FindFirstChildOfClass("Humanoid")
                        local hrp = char:FindFirstChild("HumanoidRootPart")
                        if hum and hrp then
                            local dist = myHRP and (myHRP.Position - hrp.Position).Magnitude or 0
                            local visible = dist <= maxDist and hum.Health > 0
                            local showGlow = visible and (espOpt.glow == true or espOpt.box ~= true and espOpt.name ~= true)
                            local showBox  = visible and (espOpt.box  == true or espOpt.glow ~= true and espOpt.name ~= true)
                            d.highlight.Enabled = showGlow
                            d.highlight.FillColor = espColor
                            d.highlight.OutlineColor = espColor
                            d.boxBill.Enabled = showBox
                            d.boxStroke.Color = espColor
                            local lines = {}
                            if espOpt.name ~= false then
                                local n = player.Name
                                if espOpt.displayName and player.DisplayName ~= player.Name then
                                    n = player.DisplayName .. " (@" .. player.Name .. ")"
                                end
                                table.insert(lines, n)
                            end
                            if espOpt.health ~= false then
                                local hp = math.clamp(hum.Health, 0, hum.MaxHealth)
                                local pct = math.floor(hp / math.max(hum.MaxHealth, 1) * 100)
                                table.insert(lines, string.format('<font color="#ffffff">HP: %d%%</font>', pct))
                            end
                            if espOpt.distance ~= false then
                                table.insert(lines, string.format("%d m", math.floor(dist)))
                            end
                            d.textBill.Enabled = visible and #lines > 0
                            if #lines > 0 then
                                d.label.Text = table.concat(lines, "\n")
                                d.label.TextColor3 = espColor
                            end
                            local showTracer = false
                            if visible and espOpt.tracers == true then
                                local p, onScreen = cam:WorldToViewportPoint(hrp.Position)
                                if onScreen then
                                    local a = Vector2.new(vp.X / 2, vp.Y)
                                    local b = Vector2.new(p.X, p.Y)
                                    local diff = b - a
                                    d.tracer.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
                                    d.tracer.Size = UDim2.fromOffset(diff.Magnitude, 1.5)
                                    d.tracer.Rotation = math.deg(math.atan2(diff.Y, diff.X))
                                    d.tracer.BackgroundColor3 = espColor
                                    showTracer = true
                                end
                            end
                            d.tracer.Visible = showTracer
                        end
                    end
                end
            end
        end
    end

