    local CONFIG_NAME = "Onrusha Hub cfg Survive Your Ideas"
    makeButton(mSave, "saveCfg", "Save Config", CONFIG_NAME, "Save", function()
        saveSettings()
        notify("Config saved: " .. CONFIG_NAME)
    end)
    makeButton(mSave, "loadCfg", "Load Config", CONFIG_NAME, "Load", function()
        loadSettings()
        notify("Config loaded: " .. CONFIG_NAME)
    end)

    --========================================================--
    --  RELEASE MOUSE ON CLOSE
    --========================================================--
    do
        local origHide, origToggle = ui.Hide, ui.Toggle
        if type(origHide) == "function" then
            ui.Hide = function(self) local ok, err = pcall(origHide, self) releaseMouse() return ok, err end
        end
        if type(origToggle) == "function" then
            ui.Toggle = function(self) local ok, err = pcall(origToggle, self) releaseMouse() return ok, err end
        end
        track(UserInputService.InputBegan:Connect(function(input, gpe)
            if not gpe and input.KeyCode == Enum.KeyCode.H then
                task.delay(0.05, releaseMouse)
            end
        end))
    end
    --========================================================--

    return ui
end
