local function releaseMouse()
    pcall(function()
        UserInputService.MouseBehavior    = Enum.MouseBehavior.Default
        UserInputService.MouseIconEnabled = true
    end)
end

local function safeClick(guiButton)
    if not guiButton then return false end
    if not (guiButton:IsA("TextButton") or guiButton:IsA("ImageButton")) then return false end
    local ok = pcall(function() guiButton.MouseButton1Click:Fire() end)
    if ok then return true end
    if getconnections then
        local ok2 = pcall(function()
            for _, c in ipairs(getconnections(guiButton.MouseButton1Click)) do
                if c.Fire then pcall(function() c:Fire() end) end
            end
        end)
        if ok2 then return true end
    end
    if VirtualUser then
        pcall(function()
            local pos = guiButton.AbsolutePosition + guiButton.AbsoluteSize / 2
            VirtualUser:CaptureController()
            VirtualUser:Button1Down(pos)
            task.wait(0.05)
            VirtualUser:Button1Up(pos)
        end)
    end
    return true
end
