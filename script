            local auraEnabled = false
            local selectedAura = "Purp"
            local auraModelCache = nil
            local currentAuraObjects = {}
            local auraUpdateConn = nil

            local function clearAura()
                for _, obj in ipairs(currentAuraObjects) do
                    if obj and obj.Parent then obj:Destroy() end
                end
                currentAuraObjects = {}
                if auraUpdateConn then auraUpdateConn:Disconnect() auraUpdateConn = nil end
            end

            local function loadAuraModel()
                local success, result = pcall(function()
                    return game:GetObjects("rbxassetid://" .. tostring(AURA_ASSET_ID))
                end)
                if success and type(result) == "table" and #result > 0 then return result[1] end
                return nil
            end

            local function getAuraModel()
                if not auraModelCache then auraModelCache = loadAuraModel() end
                return auraModelCache
            end

            local function applyCustomColors(instance)
                local c1 = wig.AuraColor1:Get()
                local c2 = wig.AuraColor2:Get()
                local c3 = wig.AuraColor3:Get()
                local colorSeq = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, c1),
                    ColorSequenceKeypoint.new(0.5, c2),
                    ColorSequenceKeypoint.new(1, c3),
                })
                for _, desc in ipairs(instance:GetDescendants()) do
                    if desc:IsA("ParticleEmitter") then desc.Color = colorSeq
                    elseif desc:IsA("Beam") then desc.Color = colorSeq
                    elseif desc:IsA("Trail") then desc.Color = colorSeq
                    elseif desc:IsA("PointLight") or desc:IsA("SpotLight") or desc:IsA("SurfaceLight") then desc.Color = c1
                    elseif desc:IsA("Fire") or desc:IsA("Smoke") or desc:IsA("Sparkles") then desc.Color = c1
                    elseif desc:IsA("Highlight") then desc.FillColor = c1 desc.OutlineColor = c2
                    elseif desc:IsA("Decal") or desc:IsA("Texture") then desc.Color3 = c1
                    end
                end
            end

            local function applyAura()
                clearAura()
                if not auraEnabled then return end
                local char = getChar()
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not char or not hrp then return end
                local model = getAuraModel()
                if not model then
                    notify("Failed to load aura model", "Error")
                    wig.AuraToggle:Set(false)
                    return
                end
                local searchName = "Aura_" .. selectedAura
                local auraObject = nil
                for _, desc in ipairs(model:GetDescendants()) do
                    if desc.Name == searchName then auraObject = desc break end
                end
                if not auraObject then
                    for _, desc in ipairs(model:GetDescendants()) do
                        if desc.Name:find(selectedAura) then auraObject = desc break end
                    end
                end
                if not auraObject then
                    notify("Aura not found in model", "Warning")
                    wig.AuraToggle:Set(false)
                    return
                end
                local bodyParts = {}
                local function scanForParts(inst)
                    for _, child in ipairs(inst:GetChildren()) do
                        if child:IsA("BasePart") then table.insert(bodyParts, child) end
                        scanForParts(child)
                    end
                end
                scanForParts(auraObject)
                if #bodyParts == 0 then bodyParts = { auraObject } end
                local totalCloned = 0
                for _, auraPart in ipairs(bodyParts) do
                    local targetPart = char:FindFirstChild(auraPart.Name)
                    if not targetPart and auraPart.Name == "Torso" then targetPart = char:FindFirstChild("UpperTorso") end
                    if not targetPart and auraPart.Name == "UpperTorso" then targetPart = char:FindFirstChild("Torso") end
                    if not targetPart then targetPart = hrp end
                    for _, effect in ipairs(auraPart:GetChildren()) do
                        if not effect:IsA("BasePart") then
                            local clone = effect:Clone()
                            for _, desc in ipairs(clone:GetDescendants()) do
                                if desc:IsA("Sound") then desc:Destroy() end
                            end
                            if wig.AuraCustomColor:Get() then applyCustomColors(clone) end
                            clone.Parent = targetPart
                            table.insert(currentAuraObjects, clone)
                            totalCloned += 1
                        end
                    end
                end
                auraUpdateConn = RunService.Heartbeat:Connect(function()
                    if not auraEnabled or not getChar() then clearAura() end
                end)
                if totalCloned > 0 then notify("Applied: " .. selectedAura, "Success")
                else
                    notify("No effects found in this aura", "Warning")
                    wig.AuraToggle:Set(false)
