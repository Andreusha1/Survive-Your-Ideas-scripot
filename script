    local originalPosition, safePlatform, platformCoords
    local function teleportToPlatform()
        local hrp = getHRP()
        if not hrp then notify("No character") return end
        local height = getNum("height", 100)
        local fresh = (originalPosition == nil)
        if fresh then originalPosition = hrp.CFrame end
        local x, z
        if (not fresh) and platformCoords then
            x, z = platformCoords.X, platformCoords.Z
        else
            x, z = hrp.Position.X, hrp.Position.Z
        end
        if fresh or not safePlatform or not safePlatform.Parent
            or not platformCoords or platformCoords.Y ~= height then
            if safePlatform then safePlatform:Destroy() end
            platformCoords = Vector3.new(x, height, z)
