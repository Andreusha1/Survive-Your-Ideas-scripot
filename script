        local PRESETS = {
            Rainbow = { mode = "rainbow" },
            Fire = { color1 = Color3.fromRGB(255, 80, 0), color2 = Color3.fromRGB(255, 200, 0) },
            Ice = { color1 = Color3.fromRGB(120, 220, 255), color2 = Color3.fromRGB(255, 255, 255) },
