    -- WORD SENDER
    local mWord    = tabs.Misc:SectionCreate({ Name = "Word Sender", Side = "Left" })
    local mWordSet = tabs.Misc:SectionCreate({ Name = "Word Settings", Side = "Right" })

    local WORD_GROUPS = {
        { name = "Weapons",   words = { "Sniper", "RPG", "Katana", "Shield", "Gun", "Bomb", "Knife", "Sword" } },
        { name = "Disasters", words = { "Lava", "Tsunami", "Nuke", "Meteor", "Tornado", "Flood", "Earthquake", "Volcano" } },
        { name = "Animals",   words = { "Dog", "Cat", "Shark", "Dragon", "Bear", "Wolf", "Spider", "Snake" } },
        { name = "Weather",   words = { "Rain", "Snow", "Fog", "Storm", "Night", "Day", "Heat", "Wind" } },
    }
    local selectedGroup = "Weapons"

    local function getWordToSend(random)
        if random then
            for _, g in ipairs(WORD_GROUPS) do
                if g.name == selectedGroup then
                    local rw = g.words[math.random(1, #g.words)]
                    settings.values.word = rw
                    saveSettings()
                    return rw
                end
            end
        end
        return settings.values.word or ""
    end

    local function findWordRemote()
        local wr = ReplicatedStorage:FindFirstChild("WriterRemotes")
        return wr and wr:FindFirstChild("SubmitWord")
    end

    local function executeWordSubmit(word)
        if not word or word == "" then return false end
        local r = findWordRemote()
        if r then
            local ok = pcall(function() r:FireServer(word) end)
            if ok then notify("Sent -> " .. word, "Success") return true end
        end
        notify("Remote not found", "Error")
        return false
    end

    local wordInput = mWord:InputCreate({
        Id = "word", Name = "Word", Description = "Type a word manually",
        Placeholder = "Type a word...", Default = settings.values.word or "Sniper", MaxLength = 60,
    })
    wordInput:OnChanged(function(v) settings.values.word = v saveSettings() end)

    mWord:ButtonCreate({
        Id = "sendWord", Name = "Send Word", Description = "Send current word",
        ButtonText = "Send",
    }):OnClick(function()
        local word = getWordToSend(false)
        if word == "" then notify("Empty word", "Warning") return end
        executeWordSubmit(word)
    end)

    local groupOptions = {}
    for _, g in ipairs(WORD_GROUPS) do table.insert(groupOptions, g.name) end
    mWordSet:DropdownCreate({
        Id = "wordGroup", Name = "Category", Options = groupOptions, Default = selectedGroup,
    }):OnChanged(function(v) selectedGroup = v settings.values.wordGroup = v saveSettings() end)

    local smartConnections = {}
    local senderMode = nil
    local lastFiredTick = 0
    local COOLDOWN = 3.5
    local exactPatterns = { "your turn to write", "your turn", "it's your turn", "sıra sende", "sira sende" }

    local function tryInstantFire(sourceName)
        local now = tick()
        if (now - lastFiredTick) < COOLDOWN then return end
        local word = getWordToSend(senderMode == "random")
        if word == "" then return end
        lastFiredTick = now
        if executeWordSubmit(word) then
            notify("⚡ Sent (" .. sourceName .. ") -> " .. word, "Success")
        end
    end

    local function isMatch(text)
        if type(text) ~= "string" or text == "" then return false end
        local lower = text:lower()
        for _, p in ipairs(exactPatterns) do
            if lower:find(p, 1, true) then return true end
        end
        return false
    end

    local function isOwnGui(obj)
        local sg = obj:FindFirstAncestorOfClass("ScreenGui")
        if not sg then return false end
        local n = sg.Name
        return n:sub(1, 3) == "Pro" or n:sub(1, 7) == "Onrusha"
    end

    local function isReallyVisible(gui)
        local cur = gui
        while cur and cur ~= game do
            if cur:IsA("GuiObject") and not cur.Visible then return false end
            if cur:IsA("ScreenGui") and not cur.Enabled then return false end
            cur = cur.Parent
        end
        return true
    end

    local function inspectElement(element)
        if element:IsA("TextBox") and not isOwnGui(element) then
            local function onBoxVisible()
                if isReallyVisible(element) and (tick() - lastFiredTick) >= COOLDOWN then
                    tryInstantFire("Box-Opened")
                end
            end
            table.insert(smartConnections, element:GetPropertyChangedSignal("Visible"):Connect(onBoxVisible))
            onBoxVisible()
            return
        end
        if not (element:IsA("TextLabel") or element:IsA("TextButton")) then return end
        if isOwnGui(element) then return end
        local function check()
            if not isReallyVisible(element) then return end
            if isMatch(element.Text) then tryInstantFire("Turn-Text") return end
            local txt = element.Text:lower()
            if (txt == "write" or txt:find("^write%s*")) and element.AbsoluteSize.Y > 20 then
                tryInstantFire("Write-Button")
            end
        end
        table.insert(smartConnections, element:GetPropertyChangedSignal("Text"):Connect(check))
        table.insert(smartConnections, element:GetPropertyChangedSignal("Visible"):Connect(check))
        check()
    end

    local pollThread
    local function startSender()
        if pollThread then return end
        local playerGui = LocalPlayer:WaitForChild("PlayerGui")
        for _, desc in ipairs(playerGui:GetDescendants()) do inspectElement(desc) end
        table.insert(smartConnections, playerGui.DescendantAdded:Connect(inspectElement))

        local wr = ReplicatedStorage:FindFirstChild("WriterRemotes")
        local prompt = wr and wr:FindFirstChild("WriterPrompt")
        if prompt then
            table.insert(smartConnections, prompt.OnClientEvent:Connect(function()
                task.delay(math.random(30, 80) / 100, function()
                    if senderMode then tryInstantFire("Prompt") end
                end)
            end))
        end

        pollThread = task.spawn(function()
            local boxWasOpen, textWasMatch = false, false
            while true do
                local boxOpen, textMatch = false, false
                for _, d in ipairs(playerGui:GetDescendants()) do
                    if not isOwnGui(d) then
                        if d:IsA("TextBox") then
                            if isReallyVisible(d) then boxOpen = true end
                        elseif (d:IsA("TextLabel") or d:IsA("TextButton")) and isMatch(d.Text) and isReallyVisible(d) then
                            textMatch = true
                        end
                    end
                end
                if boxOpen and not boxWasOpen then tryInstantFire("Box-Poll") end
                if textMatch and not textWasMatch then tryInstantFire("Text-Poll") end
                boxWasOpen, textWasMatch = boxOpen, textMatch
                task.wait(0.2)
            end
        end)
    end

    local function stopSender()
        if pollThread then pcall(task.cancel, pollThread) pollThread = nil end
        for _, conn in ipairs(smartConnections) do
            if conn and conn.Disconnect then pcall(function() conn:Disconnect() end) end
        end
        smartConnections = {}
    end

    makeToggle(mWordSet, "autoTurn", "Auto Send: Selected Word",
        "Auto-send the word in the input field", false,
        function()
            if features["autoRandom"] and features["autoRandom"].active then
                features["autoRandom"].set(false)
            end
            senderMode = "word"
            startSender()
        end,
        function()
            if senderMode == "word" then
                senderMode = nil
                stopSender()
            end
        end)

    makeToggle(mWordSet, "autoRandom", "Auto Send: Random From Category",
        "Auto-send a random word from the selected category", false,
        function()
            if features["autoTurn"] and features["autoTurn"].active then
                features["autoTurn"].set(false)
            end
            senderMode = "random"
            startSender()
        end,
        function()
            if senderMode == "random" then
                senderMode = nil
                stopSender()
            end
        end)

    -- RELEASE MOUSE + CLOSE STATE
    do
        local origHide, origToggle = ui.Hide, ui.Toggle
        if type(origHide) == "function" then
            ui.Hide = function(self)
                local ok, err = pcall(origHide, self)
                releaseMouse()
                _G[STATE_KEY].closed = true
                return ok, err
            end
        end
        if type(origToggle) == "function" then
            ui.Toggle = function(self)
                local ok, err = pcall(origToggle, self)
                releaseMouse()
                return ok, err
            end
        end
        track(UserInputService.InputBegan:Connect(function(input, gpe)
            if not gpe and input.KeyCode == Enum.KeyCode.H then
                task.delay(0.05, releaseMouse)
            end
        end))
    end

    return ui
end
