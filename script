        }

        local function shouldApplyTo(p)
            local who = wig.TrailWho:Get()
            if who == "Everyone" then return true end
            return p == LocalPlayer
        end
        local function getLifetime() return wig.TrailLifetime:Get() / 100 end
        local function getThickness() return wig.TrailThickness:Get() / 100 end

        local function removeTrail(p)
            local data = activeTrails[p]
            if not data then return end
            for _, obj in ipairs(data) do if obj and obj.Parent then obj:Destroy() end end
            activeTrails[p] = nil
        end

        local function applyTrail(p)
            removeTrail(p)
            if not wig.Trails:Get() then return end
            if not shouldApplyTo(p) then return end
            local character = p.Character
            if not character then return end
            local hrp = character:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            local a0 = Instance.new("Attachment") a0.Name = "TrailA0" a0.Position = Vector3.new(0, 0.5, 0) a0.Parent = hrp
            local a1 = Instance.new("Attachment") a1.Name = "TrailA1" a1.Position = Vector3.new(0, -0.5, 0) a1.Parent = hrp
            local presetName = wig.TrailPreset:Get()
            local preset = PRESETS[presetName] or PRESETS.Ocean
            local trail = Instance.new("Trail")
            trail.Name = "CustomTrail"
            trail.Attachment0 = a0
            trail.Attachment1 = a1
            trail.Lifetime = getLifetime()
            trail.MinLength = 0.1
            trail.LightEmission = 1
            trail.LightInfluence = 0
            trail.FaceCamera = true
            trail.WidthScale = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 1),
                NumberSequenceKeypoint.new(0.5, getThickness()),
                NumberSequenceKeypoint.new(1, 0),
            })
            if preset.mode == "rainbow" then
                trail.Color = ColorSequence.new(Color3.fromRGB(255, 0, 0))
            else
                trail.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, preset.color1),
                    ColorSequenceKeypoint.new(1, preset.color2),
                })
            end
            trail.Parent = hrp
            activeTrails[p] = { trail, a0, a1 }
        end

        local function refreshAllTrails()
            for _, p in ipairs(Players:GetPlayers()) do applyTrail(p) end
        end

        local function startRainbow()
            if rainbowThread then task.cancel(rainbowThread) rainbowThread = nil end
            if not wig.Trails:Get() then return end
            if wig.TrailPreset:Get() ~= "Rainbow" then return end
            rainbowThread = task.spawn(function()
                local hue = 0
                while wig.Trails:Get() and wig.TrailPreset:Get() == "Rainbow" do
                    hue = (hue + 0.01) % 1
                    local color = Color3.fromHSV(hue, 1, 1)
                    for _, data in pairs(activeTrails) do
                        local trail = data[1]
                        if trail and trail.Parent then trail.Color = ColorSequence.new(color) end
                    end
                    task.wait(0.05)
                end
            end)
        end

        local function watchTrailPlayer(p)
            if p.Character then task.spawn(applyTrail, p) end
            table.insert(trailConnections, p.CharacterAdded:Connect(function()
                task.wait(0.5)
                if wig.Trails:Get() then applyTrail(p) end
            end))
        end

        wig.Trails:OnChanged(function(value)
            if value then
                for _, p in ipairs(Players:GetPlayers()) do watchTrailPlayer(p) end
                table.insert(trailConnections, Players.PlayerAdded:Connect(watchTrailPlayer))
                startRainbow()
            else
                for _, conn in ipairs(trailConnections) do if conn and conn.Disconnect then conn:Disconnect() end end
                table.clear(trailConnections)
                for _, p in ipairs(Players:GetPlayers()) do removeTrail(p) end
                if rainbowThread then task.cancel(rainbowThread) rainbowThread = nil end
            end
        end)
        wig.TrailPreset:OnChanged(function() if wig.Trails:Get() then refreshAllTrails() startRainbow() end end)
        wig.TrailWho:OnChanged(function() if wig.Trails:Get() then refreshAllTrails() end end)
        wig.TrailLifetime:OnChanged(function() if wig.Trails:Get() then refreshAllTrails() end end)
        wig.TrailThickness:OnChanged(function() if wig.Trails:Get() then refreshAllTrails() end end)
    end

