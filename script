    local clickTPConn
    makeToggle(pUtil, "clickTP", "Click TP", "Ctrl + Click teleports to mouse", false, function()
        clickTPConn = Mouse.Button1Down:Connect(function()
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl) then
                local hrp = getHRP()
                if hrp and Mouse.Hit then
                    local target = Mouse.Hit.Position
                    if target and target.Magnitude > 0 then
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.CFrame = CFrame.new(target + Vector3.new(0, 3, 0))
                    end
                end
            end
        end)
    end, function()
        if clickTPConn then clickTPConn:Disconnect() clickTPConn = nil end
    end)

    -- COMBAT TAB
    local cSafety    = tabs.Combat:SectionCreate({ Name = "Safety", Side = "Left" })
    local cAim       = tabs.Combat:SectionCreate({ Name = "Aimbot", Side = "Left" })
    local cAimTarget = tabs.Combat:SectionCreate({ Name = "Aimbot Settings", Side = "Right" })

    local originalPosition, safePlatform, platformCoords
    local function teleportToPlatform()
        local hrp = getHRP()
        if not hrp then notify("No character") return end
        local height = getNum("height", 100)
        local fresh = (originalPosition == nil)
        if fresh then originalPosition = hrp.CFrame end
        local x, z
        if (not fresh) and platformCoords then x, z = platformCoords.X, platformCoords.Z
        else x, z = hrp.Position.X, hrp.Position.Z end
        if fresh or not safePlatform or not safePlatform.Parent
            or not platformCoords or platformCoords.Y ~= height then
            if safePlatform then safePlatform:Destroy() end
