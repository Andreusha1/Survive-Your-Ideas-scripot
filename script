            Blood = { color1 = Color3.fromRGB(140, 0, 0), color2 = Color3.fromRGB(255, 30, 30) },
            Gold = { color1 = Color3.fromRGB(255, 200, 0), color2 = Color3.fromRGB(255, 255, 150) },
            Toxic = { color1 = Color3.fromRGB(120, 255, 0), color2 = Color3.fromRGB(0, 80, 0) },
            Ocean = { color1 = Color3.fromRGB(0, 120, 255), color2 = Color3.fromRGB(0, 255, 200) },
